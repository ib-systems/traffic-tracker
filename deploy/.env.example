# === Server (.env for docker-compose.server.yml) ===
REDPANDA_EXTERNAL_HOST=metrics.example.com
REDPANDA_ADMIN_PASSWORD=changeme
AGENT_SASL_USERNAME=agent
AGENT_SASL_PASSWORD=agentpass
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# === Agent (.env for docker-compose.agent.yml) ===
KAFKA_BOOTSTRAP_SERVERS=metrics.example.com:9092
KAFKA_SASL_USERNAME=agent
KAFKA_SASL_PASSWORD=agentpass
LIBVIRT_URI=qemu:///system
LIBVIRT_USERNAME=nova
LIBVIRT_PASSWORD=
OVN_NB_DB=tcp:1.1.1.1:6641
REGION_NAME=RegionOne
POLL_INTERVAL=60
